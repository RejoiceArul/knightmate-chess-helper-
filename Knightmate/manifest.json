{
  "manifest_version": 3,
  "name": "Knightmate",
  "version": "1.0.23",
  "minimum_chrome_version": "109",
  "description": "On-device chess analysis with bundled Stockfish. No account or analysis fees.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.chess.com/*",
    "*://*.lichess.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.lichess.org/*"
      ],
      "js": [
        "content/lichess-trusted-events.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.chess.com/*",
        "*://*.lichess.org/*"
      ],
      "js": [
        "config.js",
        "lib/chess.min.js",
        "content/position-utils.js",
        "content/autoplay-drag.js",
        "content/autoplay-recovery.js",
        "content/content.js",
        "content/overlay.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Knightmate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Knightmate"
}